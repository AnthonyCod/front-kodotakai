# URL base del API. En desarrollo va por el proxy de Vite (/api → BACKEND_URL).
# En producción: la URL pública completa, p. ej. https://api.ejemplo.com/api/v1
VITE_API_URL=/api/v1
# true = el backend se simula en el navegador con MSW (src/mocks).
VITE_API_MOCKING=true
# Solo desarrollo (no entra al bundle): a dónde reenvía el proxy /api.
BACKEND_URL=http://localhost:8000
